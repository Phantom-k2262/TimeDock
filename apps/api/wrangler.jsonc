{
  "name": "timedock",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",

  "limits": {
    "cpu_ms": 30000
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timesheet-portal-prod",
      "database_id": "cf8e5e1b-927a-4512-9145-439eada64d45"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "timesheet-portal-files-prod"
    }
  ],

  "vars": {
    "APP_ENV": "production",
    "MAX_UPLOAD_MIB": "10"
  }
}
